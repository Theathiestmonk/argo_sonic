# Copy to NLP/.env (optional – keys are also read from ../sonic/.env)
OPENAI_API_KEY=sk-...
SARVAM_API_KEY=sk_...
# NLP_LLM_MODEL=gpt-5.4-nano          # fastest small model on this account (reasoning off); falls back to NLP_LLM_FALLBACKS
# NLP_LLM_FALLBACKS=gpt-5-nano,gpt-4o-mini
# SARVAM_TTS_SPEAKER=priya            # bulbul:v3 voices: priya, aditya, rahul, pooja, neha, kavya, ...
# SARVAM_STT_LANG=en-IN               # or hi-IN / unknown (auto-detect)
# NLP_MIC_DEVICE=0                    # sounddevice index/name; default = system default
# MAP_NAME=office_map
# NLP_ORDER_SINK=auto                 # auto = Postgres then file fallback | postgres | file
# NLP_MOCK_BLOCKED=forward,left       # with --sim: pretend these directions are blocked
