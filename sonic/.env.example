# Copy to sonic/.env (gitignored) and fill in real values.
# This file (.env.example) is NOT gitignored — never put real secrets here,
# placeholders only.

GROQ_API_KEY=gsk_...          # free at console.groq.com — only needed by legacy sonic_agent.py
OPENAI_API_KEY=sk-...         # only needed if LLM_URL below is pointed at OpenAI instead of Ollama
SARVAM_API_KEY=sk_...         # dashboard.sarvam.ai — required unless --text-mode

DATABASE_URL=postgresql://user:password@host:5432/dbname
ROBOT_UID=SONIC-001            # must match a seeded robots.robot_uid row

# main_agent.py's LLM (render()/extract_slots()) — default is a local Ollama
# instance (`ollama pull qwen2.5:1.5b` first). Override to point at OpenAI
# or another OpenAI-compatible endpoint instead; no node needs to change.
# LLM_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=qwen2.5:1.5b
# LLM_API_KEY=ollama            # Ollama ignores this; required by real providers
# LLM_KEEP_ALIVE=10m            # Ollama-only — how long the model stays GPU-resident
#                                 after the last request (see warm_up_llm() in main_agent.py)

# Optional tuning
SONIC_TRACE=1                  # 0 to silence per-node execution tracing

# Set by backend/launcher.py when it spawns a session for a specific table
# (staff clicking a table's action button) — leave unset for the general
# wake-word loop where the guest states their table conversationally.
TABLE_NO=
# Which action button was clicked ("order"/"deliver"/"bill"/"room_service")
# — set alongside TABLE_NO. Selects the kitchen->table->kitchen round trip
# (order/bill/room_service) vs. the pickup-wait-then-deliver routine
# (deliver). Leave unset for the general wake-word loop.
SONIC_ACTION_HINT=
# Which src/argo_mini/waypoints/<name>.json to navigate against.
SONIC_MAP_NAME=office_map

