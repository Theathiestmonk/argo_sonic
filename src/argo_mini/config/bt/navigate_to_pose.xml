<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="1000" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithReplanning">
        <!-- Raised from 3.0 - was throttling global replans to every ~333ms
             despite NTFields (planner_server/GridBased) itself running in
             well under 30ms per call (benchmarked directly on this Jetson,
             see argo_sonic_nav.py history). 20.0 matches controller_server's
             own controller_frequency below it in nav2.yaml - there's no
             benefit replanning faster than the local MPPI loop that
             actually consumes {path} can react to it. NTFields has no live
             obstacle awareness of its own (trained only on the static map,
             no costmap subscription) - this makes it recompute a fresh
             route from the robot's ACTUAL current pose much sooner after a
             deviation or a recovery backup/spin, not "notice" a dynamic
             obstacle mid-corridor - that's still entirely MPPI/local-costmap's job. -->
        <RateController hz="20.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>

      <!-- Recovery: clear the local costmap and replan. That is the whole
           of it. No BackUp, no Wait, no Spin — recovery neither moves the
           robot nor stalls it, it just hands the planner fresh obstacle
           data and lets the PipelineSequence above try again immediately.

           BackUp was tried here and removed: it caused more trouble than it
           fixed, and reverse is the direction this base senses worst — two
           rear ultrasonics, no lidar, no depth. explore_navigate_to_pose.xml
           had already reached the same conclusion on its own ("No <BackUp>
           — always fails near frontier walls; causes positional jitter").
           Before that, mppi_reverse_controller tried to enable MPPI reverse
           during recovery and never worked at all, because the flag meant
           to trigger it was only written by a hook nothing ever called.
           Reversing during recovery has now been tried twice and dropped
           twice: treat a third attempt with suspicion.

           A Wait was briefly here too and was dropped as well — a recovery
           that pauses is a recovery that does nothing while the goal clock
           runs. Replanning against a cleared costmap is both faster and the
           only step that actually changes the situation. -->
      <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>

    </RecoveryNode>

  </BehaviorTree>
</root>