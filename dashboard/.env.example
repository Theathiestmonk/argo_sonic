# Copy to dashboard/.env.local (gitignored) and fill in from your Supabase
# project: Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is safe to ship in the built JS bundle by design —
# it identifies requests as the `anon`/`authenticated` role, and Row Level
# Security (see sonic/auth_rls_schema.sql) is what actually protects data,
# not secrecy of this key.
#
# NEVER put the service_role key here (or anywhere under dashboard/) — it
# bypasses RLS entirely and must only ever live on a trusted backend
# (sonic/.env's DATABASE_URL is the equivalent trusted-backend path already
# in use by sonic_agent.py / backend/launcher.py).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
